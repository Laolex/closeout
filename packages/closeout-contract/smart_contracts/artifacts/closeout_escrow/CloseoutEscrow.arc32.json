    "contract": {
        "name": "CloseoutEscrow",
        "desc": "One fixed-price Closeout job.\n\nThis contract is deliberately a single-job escrow. It makes the release and\nrefund rules easy to audit before a multi-job box-backed application exists.",
        "methods": [
            {
                "name": "configure",
                "args": [
                    {
                        "type": "address",
                        "name": "buyer"
                    },
                    {
                        "type": "address",
                        "name": "provider"
                    },
                    {
                        "type": "uint64",
                        "name": "usdc"
                    },
                    {
                        "type": "uint64",
                        "name": "amount"
                    },
                    {
                        "type": "uint64",
                        "name": "expiresAtRound"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Stores the immutable job terms and opts the application into the exact ASA.\nThe deployment client must supply the asset as an app resource and cover the\ninner transaction fee."
            },
            {
                "name": "fund",
                "args": [
                    {
                        "type": "axfer",
                        "name": "payment"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Accepts only the exact USDC transfer grouped with this application call."
            },
            {
                "name": "markDelivered",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Records that the named provider submitted a delivery commitment off-chain."
            },
            {
                "name": "markAccepted",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Marks the delivery accepted. Release stays a separate transition."
            },
            {
                "name": "release",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Releases the exact funded amount once, and only after buyer acceptance.\n\nEither party may submit it. Acceptance is already the buyer's\nauthorization to pay, so the transfer is not a second discretionary\ndecision \u2014 and leaving it buyer-only would let a buyer who accepts and\nthen goes quiet strand the funds against a delivery they signed off,\nwith the provider holding no move of their own."
            },
            {
                "name": "refund",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Returns funds to the buyer when an *unresolved* job has expired.\n\nFunded and delivered are unresolved; accepted is not. Acceptance is\none-way, so a buyer cannot accept a delivery, sit out the expiry and\nclaw back payment for work they already signed off. Uncertainty\nresolves to the buyer; a recorded acceptance resolves to the provider."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "no_op": "CREATE"
    }
}