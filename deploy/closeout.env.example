# One payout account across every endpoint in this project: the cash
# prizes are judged per project, and a single merchant reads as one.
PAY_TO=CNV5V6PIO2JUIFXFTSFEJ3LDIMZLHXXRUVCWDYIGRZGYZEVYUBLMXZGGMA

# Absolute, and it MUST resolve and answer. `resource` is what Bazaar
# lists and what an agent dereferences; an unreachable origin scores
# zero no matter how well funded the account is.
